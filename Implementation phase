<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>오픈소스설계 - 주식 뉴스 감성 분석 시스템</title>
    <style>
        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            background-color: #f4f6f9;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container {
            width: 100%;
            max-width: 500px;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 24px;
            box-sizing: border-box;
        }
        h2 {
            text-align: center;
            color: #333;
            margin-bottom: 24px;
        }
        .card {
            background: #edf2f7;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 20px;
            text-align: center;
        }
        .balance-title {
            font-size: 14px;
            color: #4a5568;
            margin: 0;
        }
        .balance-amount {
            font-size: 24px;
            font-weight: bold;
            color: #2b6cb0;
            margin: 8px 0 0 0;
        }
        .sentiment-badge {
            display: inline-block;
            background: #e2e8f0;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: bold;
            margin-top: 8px;
        }
        .form-group {
            margin-bottom: 16px;
        }
        label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            color: #4a5568;
        }
        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #cbd5e0;
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 16px;
        }
        button {
            width: 100%;
            padding: 14px;
            background: #3182ce;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s;
        }
        button:hover {
            background: #2b6cb0;
        }
        .toast {
            visibility: hidden;
            min-width: 250px;
            background-color: #333;
            color: #fff;
            text-align: center;
            border-radius: 8px;
            padding: 16px;
            position: fixed;
            z-index: 1;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 14px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }
        .toast.show {
            visibility: visible;
            animation: fadein 0.5s, fadeout 0.5s 2.5s;
        }
        @keyframes fadein { from {bottom: 0; opacity: 0;} to {bottom: 30px; opacity: 1;} }
        @keyframes fadeout { from {bottom: 30px; opacity: 1;} to {bottom: 0; opacity: 0;} }
    </style>
</head>
<body>

<div class="container">
    <h2>주식 뉴스 감성 분석 시스템</h2>
    
    <!-- 투자 잔고 카드 -->
    <div class="card">
        <p class="balance-title">현재 가상 투자 잔고</p>
        <p class="balance-amount" id="balance">100,000,000 원</p>
    </div>

    <!-- 실시간 뉴스 감성 지수 -->
    <div class="card">
        <p class="balance-title">실시간 뉴스 감성 지수</p>
        <span class="sentiment-badge" id="sentiment">긍정 (최근 뉴스 호재 반영)</span>
    </div>

    <!-- 주문 폼 -->
    <div class="form-group">
        <label for="stockCode">종목코드 입력</label>
        <input type="text" id="stockCode" placeholder="예: 005930">
    </div>
    
    <div class="form-group">
        <label for="quantity">매수 수량 입력</label>
        <input type="number" id="quantity" placeholder="예: 10">
    </div>

    <button onclick="submitOrder()">가상 매수 주문 제출</button>
</div>

<!-- 토스트 알림 메시지 -->
<div id="toast" class="toast">가상 매매 주문 체결 완료 및 로컬 원장 파일 백업 성공</div>

<script>
    // 초기 가상 잔고 (1억 원)
    let currentBalance = 100000000;
    const mockStockPrice = 75000; // 삼성전자 예시 단가

    function submitOrder() {
        const stockCode = document.getElementById('stockCode').value.trim();
        const quantityInput = document.getElementById('quantity').value.trim();
        
        if (!stockCode || !quantityInput) {
            alert("종목코드와 수량을 모두 입력해 주세요.");
            return;
        }

        const qty = parseInt(quantityInput);
        if (isNaN(qty) || qty <= 0) {
            alert("올바른 수량을 입력해 주세요.");
            return;
        }

        const totalCost = mockStockPrice * qty;

        if (currentBalance < totalCost) {
            alert("잔액이 부족하여 주문을 체결할 수 없습니다.");
            return;
        }

        // 잔고 차감 및 화면 업데이트
        currentBalance -= totalCost;
        document.getElementById('balance').innerText = currentBalance.toLocaleString() + " 원";

        // 성공 토스트 알림 띄우기
        showToast();
    }

    function showToast() {
        const toast = document.getElementById("toast");
        toast.className = "toast show";
        setTimeout(function(){ toast.className = toast.className.replace("show", ""); }, 3000);
    }
</script>

</body>
</html>
